{
  "name": "vip-tattoo-school-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:types": "tsc --noEmit",
    "build:styles": "tailwindcss -i ./src/card-fan-carousel.css -o ./dist/card-fan-carousel.css --minify && tailwindcss -i ./src/testimonial-stack.css -o ./dist/testimonial-stack.css --minify",
    "build:scripts": "esbuild ./src/case-carousel-entry.tsx --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=./dist/card-fan-carousel.js && esbuild ./src/testimonial-stack-entry.tsx --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=./dist/testimonial-stack.js && esbuild ./src/certificate-tilt-entry.tsx --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=./dist/certificate-tilt.js",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:types && npm run build:styles && npm run build:scripts && npm run build:site",
    "start": "npm run build && node server.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
